# 将本文件复制成 .env，与 compose.yaml 放在同一目录。
# 必填。运行 openssl rand -hex 24 生成初始化口令，并填入等号后。
COGGROW_SETUP_CODE=

# Docker 主机的访问端口。端口冲突时可改成 9101 等。
COGGROW_PORT=9100

# 有 HTTPS 反代时设为 1。直接用 HTTP 访问时填 0。
COGGROW_SECURE_COOKIE=0

# 可选。固定到某个已发布的标签，或使用自行构建的镜像。
# COGGROW_IMAGE=ghcr.io/sagehere/coggrow:latest

# 可选。启用 AI 阅读出题时填写以下三项。
# COGGROW_AI_BASE_URL=https://api.example.com/v1
# COGGROW_AI_MODEL=your-model
# COGGROW_AI_KEY=
